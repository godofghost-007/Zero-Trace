# Local developer defaults: the API binds to loopback; Vite proxies /api/v1 to Flask.
FLASK_APP=backend:create_app
FLASK_DEBUG=false
FLASK_SECRET_KEY=local-demo-only-not-for-production
DATABASE_URL=sqlite:///instance/zerotrace.db
# PostgreSQL path (start `docker compose --profile core up -d` first):
# DATABASE_URL=postgresql+psycopg://zerotrace:zerotrace-dev-only@127.0.0.1:5432/zerotrace_bff
REDIS_URL=
REDIS_STREAM=zerotrace:events
ZEROTRACE_DATA_DIR=instance
AUDIT_DB_PATH=instance/guard-audit.sqlite
DEMO_MODE=true
AUTO_CREATE_SCHEMA=true

# BFF authentication. Use `flask --app backend:create_app create-user`
# to create the first account; do not commit a bootstrap password.
ZEROTRACE_AUTH_REQUIRED=true
ZEROTRACE_SESSION_TTL_SECONDS=28800
ZEROTRACE_COOKIE_SECURE=false
ZEROTRACE_MAX_LOGIN_ATTEMPTS=5
ZEROTRACE_LOGIN_WINDOW_SECONDS=300
ZEROTRACE_BOOTSTRAP_EMAIL=
ZEROTRACE_BOOTSTRAP_PASSWORD=
ZEROTRACE_BOOTSTRAP_ROLE=admin
ZEROTRACE_BOOTSTRAP_TENANT=tenant_local

# Metrics. Keep disabled for the local demo unless a scraper is configured.
ZEROTRACE_METRICS_ENABLED=false
ZEROTRACE_METRICS_TOKEN=
ZEROTRACE_LOG_FORMAT=text

# Guard reverse proxy. The BFF sends only the BFF-to-Guard key; the provider
# key belongs in the Guard process, not this file.
ZEROTRACE_GUARD_PROXY_ENABLED=false
ZEROTRACE_GUARD_PROXY_URL=http://127.0.0.1:8766
ZEROTRACE_GUARD_BFF_API_KEY=
