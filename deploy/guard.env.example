# Guard-only secrets. Copy to .env.guard on the server, chmod 600, and keep it
# out of source control. Do not add the provider key to .env.production.
ZEROTRACE_GUARD_API_KEY_SECRET=
ZEROTRACE_GUARD_API_KEY_DIGEST=
ZEROTRACE_GUARD_PREVIOUS_API_KEY_DIGEST=
ZEROTRACE_GUARD_PROVIDER_API_KEY=
ZEROTRACE_GUARD_UPSTREAM_ALLOWLIST=https://integrate.api.nvidia.com
ZEROTRACE_GUARD_ALLOWED_MODELS=
ZEROTRACE_GUARD_PII_ACTION=block
ZEROTRACE_GUARD_REQUIRE_API_KEY=true
ZEROTRACE_GUARD_HOST=127.0.0.1
ZEROTRACE_GUARD_PORT=8766
ZEROTRACE_GUARD_AUDIT_LOG=
