# Production reverse proxy. Caddy obtains and renews TLS automatically.
# Set ZEROTRACE_DOMAIN in the environment before starting the stack.

{$ZEROTRACE_DOMAIN} {
	encode zstd gzip

	request_body {
		max_size 1MB
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "same-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
	}

	# Edge rate limits are a coarse first line of defense. The BFF and engine
	# retain their own application-level limits. `remote_host` is the direct
	# peer; if Cloudflare proxying is enabled, configure trusted proxies or the
	# limit will key on Cloudflare's address rather than the client.
	rate_limit {
		zone auth {
			match {
				path /api/v1/auth/*
			}
			key {remote_host}
			events 10
			window 1m
		}
		zone api {
			match {
				path /api/v1/*
			}
			key {remote_host}
			events 300
			window 1m
		}
		jitter 0.1
	}

	# The BFF shares the engine network namespace, so it is reachable at
	# engine:3000 from Caddy while the engine itself stays off the host.
	reverse_proxy engine:3000 {
		header_up X-Real-IP {remote_host}
	}

	log {
		output stdout
		format json
	}
}
