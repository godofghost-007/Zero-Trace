# Copy to .env for local development only. Never commit .env.
# Values are intentionally blank until the deployment decisions are approved.

ZEROTRACE_ENV=development
ZEROTRACE_LOG_LEVEL=INFO
FLASK_SECRET_KEY=
ZEROTRACE_AUTH_SECRET=
ZEROTRACE_SESSION_SECRET=
ZEROTRACE_MAX_REQUEST_BYTES=1048576
ZEROTRACE_TRUST_PROXY=false
# Production must set both to false; startup validation enforces it.
AUTO_CREATE_SCHEMA=true
DEMO_MODE=true

# BFF authentication. Create the first account with:
#   flask --app backend:create_app create-user
# Or set the bootstrap values once for a local demo (never commit real values).
ZEROTRACE_AUTH_REQUIRED=true
ZEROTRACE_SESSION_TTL_SECONDS=28800
ZEROTRACE_COOKIE_SECURE=false
ZEROTRACE_MAX_LOGIN_ATTEMPTS=5
ZEROTRACE_LOGIN_WINDOW_SECONDS=300
ZEROTRACE_LOCKOUT_SECONDS=900
ZEROTRACE_BOOTSTRAP_EMAIL=
ZEROTRACE_BOOTSTRAP_PASSWORD=
ZEROTRACE_BOOTSTRAP_ROLE=admin
ZEROTRACE_BOOTSTRAP_TENANT=tenant_local

# MFA. Generate a Fernet key with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Production requires this value; the local demo derives a fallback from SECRET_KEY.
ZEROTRACE_MFA_ISSUER=ZeroTrace
ZEROTRACE_MFA_ENCRYPTION_KEY=
ZEROTRACE_PASSWORD_RESET_TTL_SECONDS=1800

# Optional OIDC. Leave disabled for the local demo. Auto-provisioning is off by
# default; pre-create users or explicitly enable it for a controlled tenant.
ZEROTRACE_OIDC_ENABLED=false
ZEROTRACE_OIDC_ISSUER=
ZEROTRACE_OIDC_CLIENT_ID=
ZEROTRACE_OIDC_CLIENT_SECRET=
ZEROTRACE_OIDC_SCOPE=openid email profile
ZEROTRACE_OIDC_AUTO_PROVISION=false
ZEROTRACE_OIDC_DEFAULT_ROLE=viewer
ZEROTRACE_OIDC_TENANT=tenant_local

# Database and event infrastructure.
# Supabase: use the transaction pooler URL for the app and the direct URL for
# migrations. Keep credentials out of source control.
DATABASE_URL=
REDIS_URL=

# Live engine. The engine binds to loopback only and is called by the BFF.
ZEROTRACE_ENGINE_HOST=127.0.0.1
ZEROTRACE_ENGINE_PORT=8765
ZEROTRACE_ENGINE_API_KEY=
ZEROTRACE_ENGINE_AUTH_SECRET=
ZEROTRACE_ENGINE_URL=http://127.0.0.1:8765
ZEROTRACE_POSTGRES_POOL_MIN=1
ZEROTRACE_POSTGRES_POOL_MAX=5
ZEROTRACE_SCAN_QUEUE_DEPTH=50
ZEROTRACE_SCAN_TARGET_COOLDOWN_SECONDS=2
ZEROTRACE_SCAN_MAX_CONCURRENT=1
ZEROTRACE_SCAN_MAX_RETRIES=0

# Server-side target policy. Comma-separated exact hostnames; each entry also
# covers its subdomains. An empty allowlist means "no additional allowlist", but
# the scope and DNS authorization checks still apply.
ZEROTRACE_TARGET_ALLOWLIST=
ZEROTRACE_TARGET_DENYLIST=

# Scanner version gates. The image pins known versions; these values make a
# runtime mismatch visible in /ready and the engine status.
ZEROTRACE_NMAP_MIN_VERSION=7.80
ZEROTRACE_NMAP_EXPECTED_VERSION=
ZEROTRACE_SUBFINDER_MIN_VERSION=2.6.0
ZEROTRACE_SUBFINDER_EXPECTED_VERSION=

# Metrics. Enable only when a scraper needs the endpoint. When a token is set,
# the scraper must send Authorization: Bearer <token>.
ZEROTRACE_METRICS_ENABLED=false
ZEROTRACE_METRICS_TOKEN=
ZEROTRACE_LOG_FORMAT=text

# Encrypted backup key. Keep it outside the backup host in production.
ZEROTRACE_BACKUP_KEY=

# Guard reverse proxy (BFF side only). The BFF-to-Guard key is separate from
# the provider key. Generate a key and digest with:
#   python -m scripts.generate_guard_credentials
# Guard provider secrets belong in deploy/guard.env.example / .env.guard, not
# this file.
ZEROTRACE_GUARD_PROXY_ENABLED=false
ZEROTRACE_GUARD_PROXY_URL=http://127.0.0.1:8766
ZEROTRACE_GUARD_BFF_API_KEY=

# Production images. For a released deployment, pin immutable digests from the
# GitHub release instead of the local build tags.
ZEROTRACE_ENGINE_IMAGE=zerotrace-engine:local
ZEROTRACE_BFF_IMAGE=zerotrace-bff:local
ZEROTRACE_CADDY_IMAGE=zerotrace-caddy:local

# Reserved AI slot names. The working Guard upstream uses the
# ZEROTRACE_GUARD_* settings in deploy/guard.env.example. The detector and Intel
# model slots are not wired to a model in this release.
# NVIDIA reference values (free/trial capacity, no production SLA):
#   detector: nvidia/nemoguard-jailbreak-detect
#   upstream: nvidia/nemotron-3.5-lightning-30b-a3b
#   Intel:    deepseek-ai/deepseek-v4.1-flash
#   fallback: qwen/qwen3-coder-480b-a35b-instruct
# GUARD_DETECTOR_ENABLED=false
# GUARD_DETECTOR_BASE_URL=
# GUARD_DETECTOR_MODEL=
# GUARD_DETECTOR_API_KEY=
# GUARD_UPSTREAM_ENABLED=false
# GUARD_UPSTREAM_BASE_URL=
# GUARD_UPSTREAM_MODEL=
# GUARD_UPSTREAM_API_KEY=
# INTEL_MODEL_ENABLED=false
# INTEL_MODEL_BASE_URL=
# INTEL_MODEL_MODEL=
# INTEL_MODEL_API_KEY=

# Do not place production credentials or model/API keys in this file.
